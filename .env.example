# Supabase — вкладка Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OpenRouter — ключ лежит только на сервере, в браузер не попадает
OPENROUTER_API_KEY=
# Сколько разборов бюджета в сутки на пользователя
AI_DAILY_LIMIT=20
# Адрес деплоя: OpenRouter просит его в заголовке HTTP-Referer
NEXT_PUBLIC_SITE_URL=https://findots.vercel.app
