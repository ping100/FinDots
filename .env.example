# Supabase — вкладка Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Ключ OpenRouter общим больше не задаётся: каждый пользователь заводит
# свой в настройках приложения, и платит за свои разборы сам.
# Ограничение на число разборов в сутки — чтобы зациклившийся запрос
# не сжёг деньги пользователя.
AI_DAILY_LIMIT=20
# Адрес деплоя: OpenRouter просит его в заголовке HTTP-Referer
NEXT_PUBLIC_SITE_URL=https://findots.vercel.app

# Капча на регистрации (Cloudflare Turnstile). Пока пусто — капчи нет.
# Site key сюда, secret key — в Supabase → Authentication → Attack Protection.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
